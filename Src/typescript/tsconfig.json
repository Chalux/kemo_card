{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "../..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "noEmit": true,
    "typeRoots": ["./typings"]
  },
  "include": [
    "src/**/*.mts",
    "src/**/*.d.ts",
    "typings/**/*.d.ts",
    "../../Config/mods/**/scripts-src/**/*.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
