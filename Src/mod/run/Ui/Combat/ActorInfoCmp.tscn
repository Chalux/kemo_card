[node name="ActorInfoCmp" type="PanelContainer" node_paths=PackedStringArray("_lblName", "_lblMeta", "_lblEnergy", "_lblSkill", "_lblSkillHint", "_btnRelease", "_lblAttack", "_lblMagicAttack", "_lblDefense", "_lblMagicDefense", "_lblHeal", "_lblState", "_lblMark", "_buffs")]
